{
  "name": "@node-arena/sim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./eslint.determinism.cjs": "./eslint.determinism.cjs"
  },
  "scripts": {
    "test": "node --test $(ls test/*.test.cjs | grep -v '/golden\\.test\\.cjs$')",
    "test:golden": "node --test test/golden.test.cjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.golden.json",
    "lint": "eslint src",
    "sim:golden": "node scripts/golden.cjs",
    "bench:sim": "node scripts/bench.cjs"
  },
  "dependencies": {
    "@node-arena/content": "workspace:*",
    "@node-arena/defs": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "4.10.2",
    "playwright": "1.64.0",
    "vite": "8.3.3"
  }
}
