{
  "name": "@node-arena/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "test": "tsx --test test/*.test.ts",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.check.json",
    "schemas:generate": "tsx scripts/generate-schemas.ts",
    "schemas:check": "tsx scripts/generate-schemas.ts --check",
    "lock:generate": "tsx scripts/content-lock.ts",
    "lock:check": "tsx scripts/content-lock.ts --check"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "playwright": "1.64.0",
    "vite": "8.3.3"
  }
}
