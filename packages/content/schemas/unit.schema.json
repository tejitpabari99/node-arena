{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "visual",
    "speed",
    "hp",
    "attack",
    "defense"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "visual": {
      "type": "string",
      "minLength": 1,
      "x-presentation": true
    },
    "speed": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "exclusiveMinimum": 0,
      "x-unit": "fx3"
    },
    "hp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "attack": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "defense": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/unit.schema.json",
  "title": "unit",
  "additionalProperties": false
}
