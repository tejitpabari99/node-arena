      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "exclusiveMinimum": 0,
      "x-unit": "fx3"
    },
    "laneHalfWidth": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "exclusiveMinimum": 0,
      "x-unit": "fx3"
