{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "visual",
    "footprintRadius",
    "components"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "extends": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "visual": {
      "type": "string",
      "minLength": 1,
      "x-presentation": true
    },
    "footprintRadius": {
      "type": "number",
      "minimum": 0,
      "maximum": 500,
      "x-unit": "fx3"
    },
    "components": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-zA-Z0-9]*$": {
          "type": "object",
          "properties": {
            "cap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2147483647
            },
            "troop": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            },
            "ratePerSec": {
              "type": "number",
              "exclusiveMinimum": 0,
              "x-unit": "fx3"
            },
            "radius": {
              "type": "number",
              "minimum": 0,
              "maximum": 500,
              "x-unit": "fx3"
            },
            "extraSlotAbove": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            }
          },
          "additionalProperties": false,
          "patternProperties": {
            "^(?!(?:cap|troop|ratePerSec|radius|extraSlotAbove)$)[a-z][a-zA-Z0-9]*$": {
              "anyOf": [
                {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": -2147483647,
                      "maximum": 2147483647
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "boolean"
                    }
                  ]
                },
                {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": -2147483647,
                        "maximum": 2147483647
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  }
                }
              ]
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/archetype.schema.json",
  "title": "archetype",
  "additionalProperties": false
}
