{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "visual",
    "footprint",
    "modules"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "visual": {
      "type": "string",
      "minLength": 1,
      "x-presentation": true
    },
    "footprint": {
      "type": "object",
      "required": [
        "shape"
      ],
      "properties": {
        "shape": {
          "anyOf": [
            {
              "type": "string",
              "const": "circle"
            },
            {
              "type": "string",
              "const": "box"
            }
          ]
        },
        "radius": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "exclusiveMinimum": 0,
          "x-unit": "fx3"
        },
        "w": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "exclusiveMinimum": 0,
          "x-unit": "fx3"
        },
        "d": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "exclusiveMinimum": 0,
          "x-unit": "fx3"
        }
      },
      "additionalProperties": false,
      "if": {
        "properties": {
          "shape": {
            "const": "circle"
          }
        }
      },
      "then": {
        "required": [
          "radius"
        ],
        "properties": {
          "radius": {},
          "w": false,
          "d": false
        }
      },
      "else": {
        "required": [
          "w",
          "d"
        ],
        "properties": {
          "w": {},
          "d": {},
          "radius": false
        }
      }
    },
    "modules": {
      "type": "object",
      "properties": {
        "blocksLines": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "variants": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string",
            "const": "small"
          },
          {
            "type": "string",
            "const": "big"
          }
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/next/element.schema.json",
  "title": "element",
  "additionalProperties": false
}
