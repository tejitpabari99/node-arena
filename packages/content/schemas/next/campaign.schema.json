{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "entries"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "level",
          "position"
        ],
        "properties": {
          "level": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "position": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/next/campaign.schema.json",
  "title": "campaign",
  "additionalProperties": false
}
