{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "visuals": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "model": {
              "type": "object",
              "properties": {
                "parts": {
                  "type": "string",
                  "minLength": 1
                },
                "lod": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "stages": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "object",
                    "required": [
                      "mesh"
                    ],
                    "properties": {
                      "mesh": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "enable"
                    ],
                    "properties": {
                      "enable": {
                        "type": "array",
                        "items": {
                          "type": "string",
                          "minLength": 1
                        },
                        "minItems": 1
                      }
                    },
                    "additionalProperties": false
                  }
                ]
              },
              "minItems": 1
            },
            "anim": {
              "type": "object",
              "properties": {
                "mode": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "none"
                    },
                    {
                      "type": "string",
                      "const": "node-tracks"
                    }
                  ]
                },
                "clips": {
                  "type": "object",
                  "properties": {
                    "run": {
                      "type": "string",
                      "minLength": 1
                    },
                    "death": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "team": {
              "type": "object",
              "properties": {
                "mode": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "textureSwap"
                    }
                  ]
                },
                "textures": {
                  "type": "object",
                  "properties": {
                    "blue": {
                      "type": "string",
                      "minLength": 1
                    },
                    "green": {
                      "type": "string",
                      "minLength": 1
                    },
                    "red": {
                      "type": "string",
                      "minLength": 1
                    },
                    "yellow": {
                      "type": "string",
                      "minLength": 1
                    },
                    "gray": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            },
            "label": {
              "type": "object",
              "properties": {
                "height": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "ground": {
              "type": "object",
              "properties": {
                "mesh": {
                  "type": "string",
                  "minLength": 1
                },
                "texture": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "obstacle": {
              "type": "object",
              "properties": {
                "small": {
                  "type": "string",
                  "minLength": 1
                },
                "big": {
                  "type": "string",
                  "minLength": 1
                },
                "texture": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "sky": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "light": {
              "type": "object",
              "properties": {
                "dir": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0
                },
                "ambient": {
                  "type": "object",
                  "properties": {
                    "color": {
                      "type": "string",
                      "pattern": "^#[0-9a-fA-F]{6}$"
                    },
                    "intensity": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "fx": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "texture": {
              "type": "string",
              "minLength": 1
            },
            "params": {
              "type": "object",
              "patternProperties": {
                "^.*$": {
                  "type": "number"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "sfx": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/manifest-art.schema.json",
  "title": "manifest-art",
  "x-presentation": true
}
