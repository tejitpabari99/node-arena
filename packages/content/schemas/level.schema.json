{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "id",
    "name",
    "theme",
    "bounds",
    "objective",
    "players",
    "buildings",
    "elements",
    "requires"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "2.0.0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "x-presentation": true
    },
    "source": {
      "type": "object",
      "required": [
        "game",
        "gameVersion",
        "asset"
      ],
      "properties": {
        "game": {
          "type": "string",
          "minLength": 1
        },
        "gameVersion": {
          "type": "string",
          "minLength": 1
        },
        "asset": {
          "type": "string",
          "minLength": 1
        },
        "campaignPosition": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "dialect": {
          "type": "string",
          "minLength": 1
        },
        "dropped": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "theme": {
      "type": "string",
      "minLength": 1,
      "x-presentation": true
    },
    "bounds": {
      "type": "object",
      "required": [
        "minX",
        "maxX",
        "minZ",
        "maxZ"
      ],
      "properties": {
        "minX": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "x-unit": "fx3"
        },
        "maxX": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "x-unit": "fx3"
        },
        "minZ": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "x-unit": "fx3"
        },
        "maxZ": {
          "type": "number",
          "minimum": -500,
          "maximum": 500,
          "x-unit": "fx3"
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "const": "captureAll"
    },
    "timeLimitSec": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 107374182
        },
        {
          "type": "null"
        }
      ]
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "colorKey"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "anyOf": [
              {
                "type": "string",
                "const": "human"
              },
              {
                "type": "string",
                "const": "ai"
              }
            ]
          },
          "colorKey": {
            "type": "string",
            "minLength": 1,
            "x-presentation": true
          },
          "bot": {
            "type": "object",
            "required": [
              "kind",
              "actionDelayMs",
              "behavior"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "const": "tw"
              },
              "actionDelayMs": {
                "type": "integer",
                "minimum": 50,
                "maximum": 2147483647
              },
              "behavior": {
                "anyOf": [
                  {
                    "type": "string",
                    "const": "full"
                  },
                  {
                    "type": "string",
                    "const": "attackOnly"
                  }
                ]
              },
              "script": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "op",
                        "ms"
                      ],
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "delay"
                        },
                        "ms": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "op",
                        "own",
                        "target",
                        "afterMs"
                      ],
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "line"
                        },
                        "own": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "target": {
                          "anyOf": [
                            {
                              "type": "string",
                              "pattern": "^[a-z0-9][a-z0-9-]*$"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "afterMs": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 2147483647
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "op",
                        "root"
                      ],
                      "properties": {
                        "op": {
                          "type": "string",
                          "const": "steps"
                        },
                        "root": {
                          "$defs": {
                            "Node": {
                              "type": "object",
                              "required": [
                                "goal"
                              ],
                              "properties": {
                                "goal": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "const": "line"
                                    },
                                    {
                                      "type": "string",
                                      "const": "capture"
                                    },
                                    {
                                      "type": "string",
                                      "const": "none"
                                    }
                                  ]
                                },
                                "own": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "target": {
                                  "anyOf": [
                                    {
                                      "type": "string",
                                      "pattern": "^[a-z0-9][a-z0-9-]*$"
                                    },
                                    {
                                      "type": "null"
                                    }
                                  ]
                                },
                                "delayMs": {
                                  "type": "integer",
                                  "minimum": 0,
                                  "maximum": 2147483647
                                },
                                "then": {
                                  "type": "array",
                                  "items": {
                                    "$ref": "Node"
                                  }
                                }
                              },
                              "additionalProperties": false,
                              "$id": "Node"
                            }
                          },
                          "$ref": "Node"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 2
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype",
          "pos",
          "owner",
          "level",
          "ignoreForWin"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "archetype": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "pos": {
            "type": "object",
            "required": [
              "x",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -500,
                "maximum": 500,
                "x-unit": "fx3"
              },
              "z": {
                "type": "number",
                "minimum": -500,
                "maximum": 500,
                "x-unit": "fx3"
              }
            },
            "additionalProperties": false
          },
          "owner": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "ignoreForWin": {
            "type": "boolean"
          },
          "params": {
            "type": "object",
            "properties": {
              "level": {
                "type": "object",
                "properties": {
                  "maxLevel": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 2147483647
                  }
                },
                "additionalProperties": false
              },
              "drawsLines": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              },
              "spawns": {
                "type": "object",
                "properties": {
                  "troop": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]*$"
                  },
                  "spawnSpeed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "exclusiveMinimum": 0,
                    "x-unit": "fx3"
                  },
                  "lineSpawnPenalty": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  }
                },
                "additionalProperties": false
              },
              "grows": {
                "type": "object",
                "properties": {
                  "growTime": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "exclusiveMinimum": 0,
                    "x-unit": "fx3"
                  }
                },
                "additionalProperties": false
              },
              "shoots": {
                "type": "object",
                "properties": {
                  "attackDelay": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "exclusiveMinimum": 0,
                    "x-unit": "fx3"
                  },
                  "attackRadius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "speedUpByLevel": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "radiusUpByLevel": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "radiusUnit": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "minRadius": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "neutralFires": {
                    "type": "boolean"
                  },
                  "troopPad": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "x-unit": "fx3"
                  },
                  "hitsNeutralHouses": {
                    "type": "boolean"
                  },
                  "bulletSpeed": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 500,
                    "exclusiveMinimum": 0,
                    "x-presentation": true,
                    "x-unit": "fx3"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "elements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "archetype",
          "pos",
          "yawDeg"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "archetype": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "pos": {
            "type": "object",
            "required": [
              "x",
              "z"
            ],
            "properties": {
              "x": {
                "type": "number",
                "minimum": -500,
                "maximum": 500,
                "x-unit": "fx3"
              },
              "z": {
                "type": "number",
                "minimum": -500,
                "maximum": 500,
                "x-unit": "fx3"
              }
            },
            "additionalProperties": false
          },
          "yawDeg": {
            "type": "number",
            "minimum": -360,
            "maximum": 360,
            "x-unit": "fx3"
          },
          "variant": {
            "anyOf": [
              {
                "type": "string",
                "const": "small"
              },
              {
                "type": "string",
                "const": "big"
              }
            ]
          },
          "params": {
            "type": "object",
            "properties": {
              "blocksLines": {
                "type": "object",
                "properties": {},
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "requires": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/level.schema.json",
  "title": "level",
  "additionalProperties": false
}
