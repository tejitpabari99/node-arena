{
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "palettes",
    "teamMarkers",
    "models",
    "visuals",
    "themes",
    "events",
    "camera"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "const": "1.0.0"
    },
    "palettes": {
      "type": "object",
      "required": [
        "default",
        "colorblind"
      ],
      "properties": {
        "default": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "additionalProperties": false
        },
        "colorblind": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "teamMarkers": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "src"
              ],
              "properties": {
                "src": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "primitive",
                "size"
              ],
              "properties": {
                "primitive": {
                  "anyOf": [
                    {
                      "type": "string",
                      "const": "box"
                    },
                    {
                      "type": "string",
                      "const": "capsule"
                    },
                    {
                      "type": "string",
                      "const": "cylinder"
                    }
                  ]
                },
                "size": {
                  "type": "array",
                  "items": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "visuals": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "kind",
            "model",
            "scale"
          ],
          "properties": {
            "kind": {
              "anyOf": [
                {
                  "type": "string",
                  "const": "tower"
                },
                {
                  "type": "string",
                  "const": "troop"
                }
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "yOffset": {
              "type": "number"
            },
            "teamMaterial": {
              "type": "string",
              "minLength": 1
            },
            "tint": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "anim": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "none"
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": [
                    "type",
                    "hz",
                    "amp",
                    "sway"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "bob"
                    },
                    "hz": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "amp": {
                      "type": "number",
                      "minimum": 0
                    },
                    "sway": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "additionalProperties": false
                }
              ]
            },
            "label": {
              "type": "object",
              "required": [
                "height"
              ],
              "properties": {
                "height": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "sfx": {
              "type": "string",
              "minLength": 1
            },
            "fx": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "themes": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "required": [
            "ground",
            "sky",
            "light"
          ],
          "properties": {
            "ground": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "sky": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "light": {
              "type": "object",
              "required": [
                "dir",
                "color",
                "intensity"
              ],
              "properties": {
                "dir": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "intensity": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "fog": {
              "type": "object",
              "required": [
                "color",
                "near",
                "far"
              ],
              "properties": {
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-fA-F]{6}$"
                },
                "near": {
                  "type": "number",
                  "minimum": 0
                },
                "far": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "additionalProperties": false
            },
            "props": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "model",
                  "pos"
                ],
                "properties": {
                  "model": {
                    "type": "string",
                    "minLength": 1
                  },
                  "pos": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  },
                  "scale": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "rotation": {
                    "type": "array",
                    "items": {
                      "type": "number"
                    },
                    "minItems": 3,
                    "maxItems": 3
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "sfx": {
              "type": "string",
              "minLength": 1
            },
            "fx": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "camera": {
      "type": "object",
      "required": [
        "pitchDeg",
        "fov",
        "margin"
      ],
      "properties": {
        "pitchDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 90
        },
        "fov": {
          "type": "number",
          "exclusiveMinimum": 0,
          "exclusiveMaximum": 180
        },
        "margin": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://node-arena.local/schemas/manifest.schema.json",
  "title": "manifest",
  "x-presentation": true
}
