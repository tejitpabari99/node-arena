{
  "name": "@node-arena/bots",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./harness": {
      "types": "./dist/harness.d.ts",
      "import": "./dist/harness.js"
    }
  },
  "scripts": {
    "test": "node --test $(ls test/*.test.cjs | grep -v '/golden\\.test\\.cjs$')",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.check.json",
    "lint": "eslint src"
  },
  "dependencies": {
    "@node-arena/sim": "workspace:*",
    "@node-arena/content": "workspace:*"
  }
}
