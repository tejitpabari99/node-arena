{
  "name": "node-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "pnpm --workspace-concurrency=1 --filter @node-arena/defs --filter @node-arena/content --filter @node-arena/sim --filter @node-arena/tools test",
    "test:defs": "pnpm --filter @node-arena/defs test",
    "test:content": "pnpm --filter @node-arena/content test",
    "test:sim": "pnpm --filter @node-arena/sim test",
    "test:bots": "pnpm --filter @node-arena/bots test",
    "test:bots:golden": "pnpm --filter @node-arena/bots test:golden",
    "test:tools": "pnpm --filter @node-arena/tools test",
    "test:web": "pnpm --filter @node-arena/web test",
    "build": "pnpm --filter @node-arena/defs --filter @node-arena/content --filter @node-arena/sim --filter @node-arena/tools build",
    "lint": "eslint .",
    "content:schemas": "pnpm --filter @node-arena/content schemas:generate",
    "check:schemas": "pnpm --filter @node-arena/content schemas:check",
    "content:lock": "pnpm --filter @node-arena/content lock:generate",
    "check:content": "pnpm --filter @node-arena/content lock:check",
    "sim:golden": "pnpm --filter @node-arena/sim sim:golden",
    "bench:sim": "pnpm --filter @node-arena/sim bench:sim",
    "dev": "pnpm --filter @node-arena/web dev",
    "test:web:e2e": "pnpm --filter @node-arena/web test:e2e",
    "slice:verify": "pnpm --filter @node-arena/web slice:verify",
    "test:web:all": "pnpm --filter @node-arena/web test:e2e:all",
    "validate:content": "pnpm --filter @node-arena/tools validate:content",
    "check:manifest": "pnpm --filter @node-arena/tools check:manifest",
    "check:rules": "tsx tools/src/cli.ts check:rules",
    "check:parked": "tsx tools/src/cli.ts check:parked",
    "import:tw": "tsx tools/src/cli.ts import:tw",
    "check:import": "tsx tools/src/cli.ts check:import",
    "replay:verify": "tsx tools/src/cli.ts replay:verify",
    "validate:levels": "tsx tools/src/cli.ts validate:levels",
    "bench:bots": "pnpm --filter @node-arena/bots bench",
    "bots:golden": "pnpm --filter @node-arena/bots golden",
    "balance": "tsx tools/src/cli.ts balance",
    "build:defs": "pnpm --filter @node-arena/defs build",
    "build:content": "pnpm --filter @node-arena/content build",
    "build:sim": "pnpm --filter @node-arena/sim build",
    "build:bots": "pnpm --filter @node-arena/bots build",
    "build:web": "pnpm --filter @node-arena/web build",
    "build:prerequisites": "pnpm build:defs && pnpm build:content && pnpm build:sim",
    "typecheck:defs": "pnpm exec tsc -p packages/defs/tsconfig.json --noEmit && pnpm exec tsc -p packages/defs/tsconfig.check.json",
    "typecheck:content": "pnpm exec tsc -p packages/content/tsconfig.json --noEmit && pnpm exec tsc -p packages/content/tsconfig.check.json",
    "typecheck:sim": "pnpm exec tsc -p packages/sim/tsconfig.json --noEmit && pnpm exec tsc -p packages/sim/tsconfig.golden.json",
    "typecheck:bots": "pnpm exec tsc -p packages/bots/tsconfig.json --noEmit && pnpm exec tsc -p packages/bots/tsconfig.check.json",
    "typecheck:tools": "pnpm exec tsc -p tools/tsconfig.json",
    "typecheck:web": "pnpm exec tsc -p apps/web/tsconfig.json",
    "//typecheck": "Live set only (defs, content, sim, tools); SP06/SP08 re-add typecheck:bots / typecheck:web on un-park.",
    "typecheck": "pnpm typecheck:defs && pnpm typecheck:content && pnpm typecheck:sim && pnpm typecheck:tools",
    "ci": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
