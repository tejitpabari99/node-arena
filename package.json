{
  "name": "node-arena",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "content:schemas": "pnpm --filter @node-arena/content schemas:generate",
    "check:schemas": "pnpm --filter @node-arena/content schemas:check",
    "content:lock": "pnpm --filter @node-arena/content lock:generate",
    "check:content": "pnpm --filter @node-arena/content lock:check",
    "sim:golden": "pnpm --filter @node-arena/sim sim:golden"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "eslint": "10.12.0",
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1"
  }
}
