{
  "$schema": "../../../../packages/content/schemas/manifest.schema.json",
  "schemaVersion": "1.2.0",
  "palettes": {
    "default": { "neutral": "#A0A7B0", "player.1": "#2E86FF", "player.2": "#FF4D4D", "player.3": "#FFC933", "player.4": "#35C46B" },
    "colorblind": { "neutral": "#999999", "player.1": "#0072B2", "player.2": "#D55E00", "player.3": "#F0E442", "player.4": "#009E73" }
  },
  "teamMarkers": { "neutral": "○", "player.1": "▲", "player.2": "■", "player.3": "●", "player.4": "◆" },
  "models": {
    "block": { "primitive": "box", "size": [4, 6, 4] },
    "unit": { "primitive": "capsule", "size": [0.35, 0.7, 0.35] }
  },
  "visuals": {
    "tower.standard": { "kind": "tower", "model": "block", "scale": 1, "label": { "height": 6.8 } },
    "tower.small": { "kind": "tower", "model": "block", "scale": 0.75, "label": { "height": 5.3 } },
    "tower.large": { "kind": "tower", "model": "block", "scale": 1.3, "label": { "height": 8.6 } },
    "troop.regular": { "kind": "troop", "model": "unit", "scale": 1, "anim": { "type": "bob", "hz": 2.2, "amp": 0.12, "sway": 6 } }
  },
  "themes": {
    "grass": { "ground": "#A3D419", "sky": "#FFE1B3", "light": { "dir": [-1, 2.2, 1.2], "color": "#FFF0D6", "intensity": 2.4 }, "palette": { "grass": "#A3D419", "sand": "#FFE1B3", "sandShade": "#FFCF8D" }, "scatter": { "seed": 1, "density": 0.6 } },
    "city.day": { "ground": "#DFE7DB", "sky": "#D9EAF4", "light": { "dir": [1, 2, 1], "color": "#FFFFFF", "intensity": 2 }, "fog": { "color": "#D9EAF4", "near": 250, "far": 900 } },
    "city.dusk": { "ground": "#EBD9C2", "sky": "#F2B98A", "light": { "dir": [-2, 1, 1], "color": "#FFC48A", "intensity": 1.6 }, "fog": { "color": "#F2B98A", "near": 200, "far": 700 } },
    "city.overcast": { "ground": "#C3CAC8", "sky": "#BFC6CC", "light": { "dir": [0.3, 2, 0.3], "color": "#E6EBEF", "intensity": 1.3 }, "fog": { "color": "#BFC6CC", "near": 120, "far": 450 } },
    "city.night": { "ground": "#6B7C99", "sky": "#1D2740", "light": { "dir": [-1, 2, -1], "color": "#9DB4E8", "intensity": 1.1 }, "fog": { "color": "#1D2740", "near": 150, "far": 550 } }
  },
  "events": { "Captured": { "fx": "pulse" }, "Clash": { "fx": "puff" }, "GameOver": {} },
  "camera": { "pitchDeg": 55, "fov": 45, "margin": 12 }
}
