  "fx": {
    "capture-ring": {
      "texture": "fx/CFX3_T_HollowCircle.png",
      "kind": "ring",
      "params": {
        "duration": 0.6,
        "radiusFrom": 0.4,
        "radiusTo": 2.2,
        "alpha": 0.8
      }
    },
    "capture-star": {
      "texture": "fx/CFX_T_Star_Add.png",
      "kind": "sprite-burst",
      "params": {
        "count": 6,
        "duration": 0.5,
        "size": 0.8,
        "spread": 1.2
      }
    },
    "clash-spark": {
      "texture": "fx/Spark.png",
      "kind": "sprite-burst",
      "params": {
        "count": 10,
        "duration": 0.4,
        "size": 0.7,
        "spread": 1
      }
    },
    "clash-glow": {
      "texture": "fx/glow_2.png",
      "kind": "sprite-burst",
      "params": {
        "count": 1,
        "duration": 0.3,
        "size": 2,
        "spread": 0
      }
    },
    "death-smoke": {
      "texture": "fx/smoke.png",
      "kind": "sprite-burst",
      "params": {
        "count": 4,
        "duration": 0.7,
        "size": 0.6,
        "spread": 0.5,
        "rise": 0.6
      }
    },
    "tower-shot": {
      "texture": "fx/lane-trail.png",
      "kind": "beam",
      "params": {
        "duration": 0.2,
        "width": 0.45
