    "lane-waveArrow": {
      "texture": "fx/lane-waveArrow.png",
      "kind": "beam",
      "params": {
        "width": 0.6,
        "alpha": 0.502,
        "tile": 1
      }
    },
    "lane-arrow": {
      "texture": "fx/lane-arrow.png",
      "kind": "beam",
      "params": {
        "width": 0.6,
        "alpha": 0.502,
        "tile": 1
      }
