    "BuildingCaptured": {
      "sfx": "audio/capture.ogg",
      "fx": "capture-ring"
    },
    "Clash": {
      "sfx": "audio/clash.ogg",
      "fx": "clash-spark"
    },
    "LineCut": {
      "sfx": "audio/cut.ogg"
    },
    "LineDrawn": {
      "sfx": "audio/ui-click.ogg"
    },
    "MatchOver": {
      "sfx": "audio/gameover.ogg"
    },
    "TowerShot": {
      "fx": "tower-shot"
    },
    "TroopDied": {
      "fx": "death-smoke"
    }
