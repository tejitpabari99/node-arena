{
  "$schema": "../../../packages/content/schemas/manifest.schema.json",
  "schemaVersion": "1.1.0",
  "palettes": {
    "default": {"neutral": "#8C8C8C", "player.1": "#2E8BFF", "player.2": "#F0313F", "player.3": "#FDC534", "player.4": "#35B84A"},
    "colorblind": {"neutral": "#999999", "player.1": "#0072B2", "player.2": "#D55E00", "player.3": "#F0E442", "player.4": "#009E73"}
  },
  "teamMarkers": {"neutral": "○", "player.1": "▲", "player.2": "■", "player.3": "●", "player.4": "◆"},
  "models": {
    "block": {"primitive": "box", "size": [4, 6, 4]},
    "unit": {"primitive": "capsule", "size": [0.35, 0.7, 0.35]},
    "building.small": {"src": "models/tower-small.glb"},
    "building.standard": {"src": "models/tower-standard.glb"},
    "building.large": {"src": "models/tower-large.glb"},
    "character.regular": {"src": "models/troop-regular.glb"},
    "prop.tree.pine": {"src": "models/prop-tree-pine.glb"},
    "prop.tree.round": {"src": "models/prop-tree-round.glb"},
    "prop.stump": {"src": "models/prop-stump.glb"},
    "prop.crate": {"src": "models/prop-crate.glb"}
  },
  "visuals": {
    "tower.standard": {"kind": "tower", "model": "building.standard", "scale": 3.2, "label": {"height": 7.6}},
    "tower.small": {"kind": "tower", "model": "building.small", "scale": 2.88, "label": {"height": 5.4}},
    "tower.large": {"kind": "tower", "model": "building.large", "scale": 3.12, "label": {"height": 12}},
    "troop.regular": {"kind": "troop", "model": "character.regular", "scale": 2.8, "teamMaterial": "Shirt", "anim": {"type": "bob", "hz": 2.2, "amp": 0.12, "sway": 6}}
  },
  "themes": {
    "grass": { "ground": "#A3D419", "sky": "#FFE1B3", "light": {"dir": [-1, 2.2, 1.2], "color": "#FFF0D6", "intensity": 2.8},
      "palette": {"grass": "#A3D419", "grassAlt": "#9DCB10", "sand": "#FFE1B3", "sandShade": "#FFCF8D", "rock": "#BC5439", "tree": "#028C1D", "crate": "#FD8539"},
      "scatter": {"seed": 1, "density": 34} }
  },
  "events": {
    "Captured": {"fx": "pulse", "sfx": "audio/capture.ogg"},
    "Clash": {"fx": "puff", "sfx": "audio/clash.ogg"},
    "LineCut": {"sfx": "audio/cut.ogg"},
    "LineDrawn": {"sfx": "audio/ui-click.ogg"},
    "GameOver": {"sfx": "audio/gameover.ogg"},
    "Music": {"sfx": "audio/music-insistent.ogg"}
  },
  "camera": {"pitchDeg": 65, "fov": 35, "margin": 3}
}
