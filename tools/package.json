{
  "name": "@node-arena/tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "validate:content": "tsx src/cli.ts validate:content",
    "check:manifest": "tsx src/cli.ts check:manifest",
    "test": "tsx --test $(ls test/*.test.ts src/import-tw/test/*.test.ts | grep -v '/rules-repo\\.test\\.ts$' | grep -v '/replay-golden\\.test\\.ts$')",
    "test:rules": "tsx --test test/rules-repo.test.ts",
    "test:replay": "tsx --test test/replay-golden.test.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src test",
    "check:rules": "tsx src/cli.ts check:rules",
    "replay:verify": "tsx src/cli.ts replay:verify",
    "validate:levels": "tsx src/cli.ts validate:levels",
    "levels:lock": "tsx src/cli.ts levels:lock",
    "balance": "tsx src/cli.ts balance",
    "assets:import": "node assets/import-art.mjs"
  },
  "dependencies": {
    "@node-arena/content": "workspace:*",
    "@node-arena/sim": "workspace:*",
    "@node-arena/bots": "workspace:*",
    "typebox": "1.3.36"
  },
  "devDependencies": {
    "tsx": "4.23.15",
    "typescript": "6.0.2",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "meshoptimizer": "1.3.0",
    "sharp": "0.35.5"
  }
}
